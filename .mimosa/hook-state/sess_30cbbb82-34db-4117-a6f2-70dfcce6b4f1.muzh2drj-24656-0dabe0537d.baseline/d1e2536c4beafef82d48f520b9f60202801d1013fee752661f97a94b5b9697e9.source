{
  "name": "ateq-v2-simulated-service",
  "version": "2.0.0",
  "private": true,
  "description": "A/B ATEQ station service with fake-default and gated live adapters",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "preflight:live": "node tools/livePreflight.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "modbus-serial": "^8.0.25"
  },
  "optionalDependencies": {
    "node-snap7": "^1.0.9"
  }
}
